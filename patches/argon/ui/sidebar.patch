+namespace {
+
+// Sizes from the handoff's tokens. Colors come from the system color tokens
+// for now, so light and dark both work; Argon's own Paper palette is a later
+// color-mixer patch.
+constexpr int kRowHeight = 30;
+constexpr int kRowRadius = 7;
+constexpr int kRowGap = 1;
+constexpr int kSectionGap = 14;
+constexpr int kIconTitleGap = 9;
+constexpr int kFaviconSize = 16;
+constexpr int kCloseSize = 24;
+constexpr int kCloseIconSize = 10;
+
+// ponytail: fixed until Spaces (stage 1) names spaces; then the space's name.
+constexpr char16_t kDefaultSpaceName[] = u"Home";
+
+gfx::FontList Font(int size_delta, gfx::Font::Weight weight) {
+  return gfx::FontList().Derive(size_delta, gfx::Font::NORMAL, weight);
+}
+
+// One tab: favicon and title; loose tabs also get a close button, shown while
+// the row is hovered or active.
+class ArgonTabRow : public views::Button {
+  METADATA_HEADER(ArgonTabRow, views::Button)
+
+ public:
+  ArgonTabRow(tabs::TabInterface* tab,
+              bool active,
+              PressedCallback open,
+              PressedCallback close)
+      : views::Button(std::move(open)), active_(active) {
+    SetNotifyEnterExitOnChild(true);
+    GetViewAccessibility().SetName(TabUIHelper::From(tab)->GetTitle());
+
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::TLBR(0, 8, 0, close ? 3 : 8), kIconTitleGap));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    layout->set_minimum_cross_axis_size(kRowHeight);
+
+    icon_ = AddChildView(std::make_unique<views::ImageView>());
+    icon_->SetImage(TabUIHelper::From(tab)->GetFavicon());
+    icon_->SetImageSize(gfx::Size(kFaviconSize, kFaviconSize));
+
+    title_ = AddChildView(
+        std::make_unique<views::Label>(TabUIHelper::From(tab)->GetTitle()));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_->SetFontList(Font(0, active ? gfx::Font::Weight::SEMIBOLD
+                                       : gfx::Font::Weight::NORMAL));
+    layout->SetFlexForView(title_, 1);
+
+    if (close) {
+      close_ = AddChildView(views::CreateVectorImageButton(std::move(close)));
+      views::SetImageFromVectorIconWithColor(
+          close_, vector_icons::kCloseIcon, kCloseIconSize,
+          views::IconColors(ui::kColorSysOnSurfaceSubtle,
+                            ui::kColorSysOnSurfaceSubtle));
+      close_->SetPreferredSize(gfx::Size(kCloseSize, kCloseSize));
+      close_->GetViewAccessibility().SetName(u"Close tab");
+    }
+    UpdateLook();
+  }
+  ArgonTabRow(const ArgonTabRow&) = delete;
+  ArgonTabRow& operator=(const ArgonTabRow&) = delete;
+  ~ArgonTabRow() override = default;
+
+ protected:
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateLook();
+  }
+
+ private:
+  void UpdateLook() {
+    const bool hovered = GetState() == STATE_HOVERED ||
+                         GetState() == STATE_PRESSED || IsMouseHovered();
+    if (active_) {
+      SetBackground(views::CreateRoundedRectBackground(
+          ui::kColorSysStateRippleNeutralOnSubtle, kRowRadius));
+    } else if (hovered) {
+      SetBackground(views::CreateRoundedRectBackground(
+          ui::kColorSysStateHoverOnSubtle, kRowRadius));
+    } else {
+      SetBackground(nullptr);
+    }
+    title_->SetEnabledColor(active_ || hovered ? ui::kColorSysOnSurface
+                                               : ui::kColorSysOnSurfaceSubtle);
+    if (close_) {
+      close_->SetVisible(active_ || hovered);
+    }
+  }
+
+  const bool active_;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::ImageButton> close_ = nullptr;
+};
+
+BEGIN_METADATA(ArgonTabRow)
+END_METADATA
+
+std::unique_ptr<views::Separator> MakeSeparator() {
+  auto separator = std::make_unique<views::Separator>();
+  separator->SetColorId(ui::kColorSysDivider);
+  return separator;
+}
+
+std::unique_ptr<views::View> MakeList() {
+  auto list = std::make_unique<views::BoxLayoutView>();
+  list->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  list->SetBetweenChildSpacing(kRowGap);
+  return list;
+}
+
+std::unique_ptr<views::LabelButton> MakeTextButton(
+    views::Button::PressedCallback callback,
+    std::u16string text,
+    int size_delta) {
+  auto button =
+      std::make_unique<views::LabelButton>(std::move(callback), std::move(text));
+  button->SetTextColor(views::Button::STATE_NORMAL,
+                       ui::kColorSysOnSurfaceSecondary);
+  button->SetTextColor(views::Button::STATE_HOVERED, ui::kColorSysOnSurface);
+  button->SetTextColor(views::Button::STATE_PRESSED, ui::kColorSysOnSurface);
+  button->label()->SetFontList(Font(size_delta, gfx::Font::Weight::NORMAL));
+  button->SetMinSize(gfx::Size(0, kRowHeight));
+  return button;
+}
+
+}  // namespace
+
+ArgonSidebarView::ArgonSidebarView(BrowserWindowInterface* browser)
+    : browser_(browser), model_(browser->GetTabStripModel()) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+
+  auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+  scroll->SetHorizontalScrollBarMode(views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->SetBackgroundColor(std::nullopt);
+  scroll->SetDrawOverflowIndicator(false);
+
+  auto* contents =
+      scroll->SetContents(std::make_unique<views::BoxLayoutView>());
+  contents->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  contents->SetBetweenChildSpacing(kSectionGap);
+  contents->SetInsideBorderInsets(gfx::Insets::TLBR(6, 0, 18, 0));
+  contents->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  space_name_ = contents->AddChildView(std::make_unique<views::Label>());
+  space_name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  space_name_->SetFontList(Font(-1, gfx::Font::Weight::SEMIBOLD));
+  space_name_->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+  space_name_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 8)));
+
+  contents->AddChildView(MakeSeparator());
+  kept_ = contents->AddChildView(MakeList());
+  kept_separator_ = contents->AddChildView(MakeSeparator());
+
+  auto* loose_section = contents->AddChildView(MakeList());
+  loose_ = loose_section->AddChildView(MakeList());
+
+  auto* new_row =
+      loose_section->AddChildView(std::make_unique<views::BoxLayoutView>());
+  new_row->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  auto* new_tab = new_row->AddChildView(MakeTextButton(
+      base::BindRepeating(&ArgonSidebarView::NewTab, base::Unretained(this)),
+      u"+ New", 0));
+  new_row->SetFlexForView(new_tab, 1);
+  clear_ = new_row->AddChildView(MakeTextButton(
+      base::BindRepeating(&ArgonSidebarView::CloseLooseTabs,
+                          base::Unretained(this)),
+      u"Clear", -1));
+  clear_->SetTooltipText(u"Close every loose tab in this space");
+
+  model_->AddObserver(this);
+  Rebuild();
+}
+
+ArgonSidebarView::~ArgonSidebarView() {
+  model_->RemoveObserver(this);
+}
+
+void ArgonSidebarView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::OnTabChangedAt(tabs::TabInterface* tab,
+                                      TabChangeType change_type) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                               int index) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::TabGroupedStateChanged(
+    TabStripModel* tab_strip_model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::OnTabGroupChanged(const TabGroupChange& change) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  ScheduleRebuild();
+}
+
+void ArgonSidebarView::ScheduleRebuild() {
+  if (rebuild_pending_) {
+    return;
+  }
+  rebuild_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ArgonSidebarView::Rebuild,
+                                weak_factory_.GetWeakPtr()));
+}
+
+// ponytail: rebuilds every row on any change; diff rows if long tab lists
+// make this show up in profiles.
+void ArgonSidebarView::Rebuild() {
+  rebuild_pending_ = false;
+  kept_->RemoveAllChildViews();
+  loose_->RemoveAllChildViews();
+
+  const std::optional<tab_groups::TabGroupId> focused =
+      model_->GetFocusedGroup();
+  std::u16string space_name = kDefaultSpaceName;
+  if (focused) {
+    const tabs::TabGroup* group = model_->group_model()->GetTabGroup(*focused);
+    if (group && !group->visual_data()->title().empty()) {
+      space_name = group->visual_data()->title();
+    }
+  }
+  space_name_->SetText(space_name);
+
+  bool any_loose = false;
+  for (int i = 0; i < model_->count(); ++i) {
+    tabs::TabInterface* tab = model_->GetTabAtIndex(i);
+    const bool kept = model_->IsTabPinned(i);
+    // Focus mode hides the other groups' tabs; so does the sidebar.
+    if (!kept && focused && model_->GetTabGroupForTab(i) != focused) {
+      continue;
+    }
+    auto weak_tab = tab->GetWeakPtr();
+    auto open = base::BindRepeating(&ArgonSidebarView::Activate,
+                                    weak_factory_.GetWeakPtr(), weak_tab);
+    views::Button::PressedCallback close;
+    if (!kept) {
+      close = base::BindRepeating(&ArgonSidebarView::Close,
+                                  weak_factory_.GetWeakPtr(), weak_tab);
+    }
+    (kept ? kept_ : loose_)
+        ->AddChildView(std::make_unique<ArgonTabRow>(
+            tab, i == model_->active_index(), std::move(open),
+            std::move(close)));
+    any_loose |= !kept;
+  }
+
+  const bool any_kept = !kept_->children().empty();
+  kept_->SetVisible(any_kept);
+  kept_separator_->SetVisible(any_kept);
+  clear_->SetVisible(any_loose);
+  PreferredSizeChanged();
+}
+
+void ArgonSidebarView::Activate(base::WeakPtr<tabs::TabInterface> tab) {
+  if (!tab) {
+    return;
+  }
+  const int index = model_->GetIndexOfTab(tab.get());
+  if (index != TabStripModel::kNoTab) {
+    model_->ActivateTabAt(index, TabStripUserGestureDetails(
+                                     TabStripUserGestureDetails::GestureType::kMouse));
+  }
+}
+
+// Closed tabs stay reopenable with Cmd+Shift+T (historical tab entries).
+void ArgonSidebarView::Close(base::WeakPtr<tabs::TabInterface> tab) {
+  if (!tab) {
+    return;
+  }
+  const int index = model_->GetIndexOfTab(tab.get());
+  if (index != TabStripModel::kNoTab) {
+    model_->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE |
+                                          TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
+void ArgonSidebarView::CloseLooseTabs() {
+  const std::optional<tab_groups::TabGroupId> focused =
+      model_->GetFocusedGroup();
+  std::vector<base::WeakPtr<tabs::TabInterface>> loose;
+  for (int i = 0; i < model_->count(); ++i) {
+    if (!model_->IsTabPinned(i) &&
+        (!focused || model_->GetTabGroupForTab(i) == focused)) {
+      loose.push_back(model_->GetTabAtIndex(i)->GetWeakPtr());
+    }
+  }
+  // Closing a window's last tab closes the window; Clear only empties the space.
+  if (static_cast<int>(loose.size()) == model_->count()) {
+    NewTab();
+  }
+  for (const auto& tab : loose) {
+    Close(tab);
+  }
+}
+
+void ArgonSidebarView::NewTab() {
+  chrome::ExecuteCommand(browser_, IDC_NEW_TAB);
+}
+
+BEGIN_METADATA(ArgonSidebarView)
+END_METADATA
