+#ifndef CHROME_BROWSER_UI_VIEWS_ARGON_ARGON_SIDEBAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_ARGON_ARGON_SIDEBAR_VIEW_H_
+
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace views {
+class Label;
+class LabelButton;
+class Separator;
+}  // namespace views
+
+// Argon's "Quiet sidebar" (design_handoff_argon_browser/README.md, section 2):
+// the space name, kept tabs, a divider, loose tabs, then "+ New" and "Clear".
+// It takes the place of the vertical tab strip's tab list inside
+// VerticalTabStripRegionView, which still owns the width, collapse, resize and
+// the window controls above it.
+//
+// Until Spaces (stage 1) and pins (stage 2) land: the space is the focused tab
+// group ("Home" when none), kept tabs are Chromium-pinned tabs, and loose tabs
+// are the unpinned tabs Chromium shows (only the focused group's in focus mode).
+class ArgonSidebarView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(ArgonSidebarView, views::View)
+
+ public:
+  explicit ArgonSidebarView(BrowserWindowInterface* browser);
+  ArgonSidebarView(const ArgonSidebarView&) = delete;
+  ArgonSidebarView& operator=(const ArgonSidebarView&) = delete;
+  ~ArgonSidebarView() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* tab_strip_model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void OnTabGroupFocusChanged(
+      std::optional<tab_groups::TabGroupId> new_focused_group_id,
+      std::optional<tab_groups::TabGroupId> old_focused_group_id) override;
+
+ private:
+  // Rows are rebuilt from the model after the current task, so a row is never
+  // destroyed while its own click handler runs (closing a tab notifies
+  // synchronously), and bursts of changes during page loads coalesce.
+  void ScheduleRebuild();
+  void Rebuild();
+
+  void Activate(base::WeakPtr<tabs::TabInterface> tab);
+  void Close(base::WeakPtr<tabs::TabInterface> tab);
+  void CloseLooseTabs();
+  void NewTab();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<TabStripModel> model_;
+
+  raw_ptr<views::Label> space_name_ = nullptr;
+  raw_ptr<views::View> kept_ = nullptr;
+  raw_ptr<views::Separator> kept_separator_ = nullptr;
+  raw_ptr<views::View> loose_ = nullptr;
+  raw_ptr<views::LabelButton> clear_ = nullptr;
+
+  bool rebuild_pending_ = false;
+  base::WeakPtrFactory<ArgonSidebarView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_ARGON_ARGON_SIDEBAR_VIEW_H_
