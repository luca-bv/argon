+
+void MemorySaverModePolicy::EnforceTabBudget() {
+  if (!IsMemorySaverDiscardingEnabled()) {
+    return;
+  }
+
+  // Only tabs Chromium would proactively discard anyway count against the
+  // budget; visible, active, pinned, audible, edited... tabs are untouched.
+  auto* eligibility = DiscardEligibilityPolicy::GetFromGraph(GetOwningGraph());
+  std::vector<const PageNode*> tabs;
+  for (const PageNode* page_node : GetOwningGraph()->GetAllPageNodes()) {
+    if (eligibility->CanDiscard(
+            page_node, DiscardEligibilityPolicy::DiscardReason::PROACTIVE,
+            /*ignore_recent_visibility=*/true) == CanDiscardResult::kEligible) {
+      tabs.push_back(page_node);
+    }
+  }
+
+  const size_t budget = GetTabBudget();
+  if (tabs.size() <= budget) {
+    return;
+  }
+
+  // Keep the `budget` most recently hidden tabs, discard the rest.
+  std::ranges::sort(tabs, std::greater<>(),
+                    &PageNode::GetLastVisibilityChangeTime);
+  tabs.erase(tabs.begin(), tabs.begin() + budget);
+  PageDiscardingHelper::GetFromGraph(GetOwningGraph())
+      ->ImmediatelyDiscardMultiplePages(
+          tabs, DiscardEligibilityPolicy::DiscardReason::PROACTIVE);
 }
 
