 namespace {
 MemorySaverModePolicy* g_memory_saver_mode_policy = nullptr;
 using user_tuning::prefs::MemorySaverModeAggressiveness;
+
+// Argon: number of discard-eligible background tabs allowed to stay loaded.
+// Halved on battery, in Low Power Mode, under memory pressure or when hot.
+// ponytail: macOS-only (libnotify + sysctl) and polled when a tab is hidden,
+// not observed; add PowerStateObserver/PowerThermalObserver if a state change
+// must discard before the next tab switch.
+size_t GetTabBudget() {
+  static const uint64_t ram_gib =
+      base::SysInfo::AmountOfTotalPhysicalMemory().InGiB();
+  const size_t budget = ram_gib <= 8 ? 2 : ram_gib <= 16 ? 5 : 10;
+
+  static const int low_power_token = [] {
+    int token = 0;
+    notify_register_check("com.apple.system.lowpowermode", &token);
+    return token;
+  }();
+  uint64_t low_power = 0;
+  notify_get_state(low_power_token, &low_power);
+
+  // 1 = normal, 2 = warning, 4 = critical.
+  int pressure = 0;
+  size_t pressure_size = sizeof(pressure);
+  sysctlbyname("kern.memorystatus_vm_pressure_level", &pressure,
+               &pressure_size, nullptr, 0);
+
+  auto* power_monitor = base::PowerMonitor::GetInstance();
+  const bool constrained =
+      low_power || pressure > 1 || power_monitor->IsOnBatteryPower() ||
+      power_monitor->GetCurrentThermalState() >=
+          base::PowerThermalObserver::DeviceThermalState::kSerious;
+  return constrained ? budget / 2 : budget;
+}
+
 }  // namespace
 
