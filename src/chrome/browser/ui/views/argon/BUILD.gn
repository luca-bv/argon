# Allo, decoded into the framework's Resources (argon_font.cc registers it).
# bundle_data reaches the framework bundle through //chrome/browser's deps.
action("allo_font_ttf") {
  script = "resources/decode_base64.py"
  inputs = [ "resources/AlloVariable.ttf.b64" ]
  outputs = [ "$target_gen_dir/AlloVariable.ttf" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

bundle_data("allo_font") {
  # The OFL asks for the licence to travel with the font.
  sources = get_target_outputs(":allo_font_ttf") + [ "resources/Allo-OFL.txt" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  public_deps = [ ":allo_font_ttf" ]
}
